# Use a managed PostgreSQL instance in production. SQLite is for local verification only.
DATABASE_URL=postgresql+psycopg://pricehud:CHANGE_ME@database-host:5432/pricehud
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
AGENT_API_KEY=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_SECRET
TOKEN_PEPPER=CHANGE_ME_TO_A_THIRD_LONG_RANDOM_SECRET
QUOTE_STALE_SECONDS=30
